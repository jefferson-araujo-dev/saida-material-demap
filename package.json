{
  "name": "saida-material-demap",
  "version": "1.0.0",
  "private": true,
  "description": "Gestão de Materiais | COENG - PWA de controle de saídas de materiais do almoxarifado.",
  "scripts": {
    "build:css": "tailwindcss -i css/styles.css -o css/output.css --minify",
    "watch:css": "tailwindcss -i css/styles.css -o css/output.css --watch",
    "dev": "npm run build:css && vite",
    "build": "npm run build:css && vite build",
    "preview": "vite preview",
    "test": "vitest run --exclude js/firestore-rules.emulator.test.mjs",
    "test:rules:emulator": "vitest run js/firestore-rules.emulator.test.mjs",
    "lint": "eslint js",
    "format": "prettier --write \"js/**/*.{js,mjs}\" \"*.js\"",
    "format:check": "prettier --check \"js/**/*.{js,mjs}\" \"*.js\""
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/smithnaguxi90/saida-material-demap.git"
  },
  "keywords": [],
  "author": "",
  "license": "UNLICENSED",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/smithnaguxi90/saida-material-demap/issues"
  },
  "homepage": "https://github.com/smithnaguxi90/saida-material-demap#readme",
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@firebase/rules-unit-testing": "^5.0.2",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^9.1.2",
    "prettier": "^3.9.7",
    "tailwindcss": "^3.4.19",
    "vite": "^8.1.3",
    "vitest": "^5.0.1"
  },
  "dependencies": {
    "chart.js": "^4.5.1",
    "firebase": "^12.14.0",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  }
}
