rules_version = '2';

// Regras de segurança do Firestore para "Gestão de Materiais | COENG".
//
// Modelo de dados (ver js/database.js):
//   /artifacts/{appId}/users/{uid}/lancamentos/{id}
//   /artifacts/{appId}/users/{uid}/notificacoes/{id}
//   /artifacts/{appId}/materiais/{codigo}
//   /artifacts/{appId}/materiais_meta/{doc}
//   /artifacts/{appId}/encarregados/{nome}
//   /artifacts/{appId}/auditoria/{id}
//
// A checagem de administrador usa a Custom Claim `admin: true` no token,
// definida pelo Firebase Admin SDK (ver README). O mesmo critério é usado no
// cliente (js/app.js).

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function isAdmin() {
      return isSignedIn() && request.auth.token.admin == true;
    }

    match /artifacts/{appId} {

      // ---- Lançamentos: cada usuário só acessa a própria subárvore ----
      match /users/{uid}/lancamentos/{lancamentoId} {
        allow read: if isOwner(uid);
        allow create: if isOwner(uid)
          && request.resource.data.quantidade is number
          && request.resource.data.quantidade > 0
          && request.resource.data.codigo is string
          && request.resource.data.deleted == false;
        // Edição, baixa e cancelamento (soft-delete; nunca hard-delete pelo
        // cliente). Um lançamento já cancelado (`deleted == true`) fica
        // congelado: nenhuma nova edição é aceita, o que também impede
        // reverter `deleted` de volta para `false` por essa via.
        allow update: if isOwner(uid)
          && resource.data.deleted != true
          && request.resource.data.quantidade is number
          && request.resource.data.quantidade > 0
          && request.resource.data.codigo is string;
        allow delete: if false;
      }

      // ---- Notificações: privadas do usuário ----
      match /users/{uid}/notificacoes/{notificacaoId} {
        allow read, write: if isOwner(uid);
      }

      // ---- Base de materiais: leitura para autenticados, escrita só admin ----
      match /materiais/{codigo} {
        allow read: if isSignedIn();
        allow write: if isAdmin();
      }

      match /materiais_meta/{doc} {
        allow read: if isSignedIn();
        allow write: if isAdmin();
      }

      // ---- Encarregados: qualquer autenticado cria; só admin altera/remove ----
      match /encarregados/{nome} {
        allow read: if isSignedIn();
        allow create: if isSignedIn();
        allow update, delete: if isAdmin();
      }

      // ---- Auditoria: qualquer autenticado registra a própria ação;
      // ninguém edita ou apaga; só admin lê a trilha completa.
      match /auditoria/{registroId} {
        allow read: if isAdmin();
        allow create: if isSignedIn()
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.acao is string
          && request.resource.data.acao.size() > 0
          && request.resource.data.acao.size() <= 60
          && request.resource.data.entidade is string
          && request.resource.data.entidade.size() > 0
          && request.resource.data.entidade.size() <= 60
          && request.resource.data.timestamp == request.time
          && request.resource.data.metadados is map
          && request.resource.data.metadados.size() <= 20;
        allow update, delete: if false;
      }
    }

    // Nega tudo que não foi explicitamente liberado acima.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
